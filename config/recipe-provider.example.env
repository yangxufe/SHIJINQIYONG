# Copy selected lines into private data/runtime.env only after administrator review.
# Default is off; do not start the worker without an actual configured model.
SHIJIN_RECIPE_PROVIDER=off
# For an explicitly installed local Ollama model: set provider=ollama and its actual model name.
# SHIJIN_RECIPE_MODEL=<installed-model-name>
# For the fixed official HTTPS API: set provider=openai, its actual supported model and a private key.
# SHIJIN_RECIPE_API_KEY=<private-api-key>
