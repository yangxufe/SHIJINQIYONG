# Example only. Windows: scripts/initialize_runtime.ps1. Mac: docs/MACOS.md.
# Never commit or share the generated data/runtime.env file.
SHIJIN_SECRET_KEY=<random-value-generated-locally>
SHIJIN_ALLOWED_HOSTS=<confirmed-local-IPv4>
SHIJIN_CSRF_TRUSTED_ORIGINS=https://<confirmed-local-IPv4>:8443
SHIJIN_TIME_ZONE=<your-IANA-time-zone>
SHIJIN_DATA_DIR=<absolute-local-disk-directory>
SHIJIN_STATIC_ROOT=<absolute-local-static-directory>
